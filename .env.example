# Copy to .env (beside docker-compose.yaml) and fill in.  .env is not committed.

# Google sign-in: from Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback, e.g. http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where players reach the game (no slash at the end).  Left empty, it is worked out from each request.
PUBLIC_URL=

# Where the game is served on this machine.  Left empty: port 8080 to everyone.  On a server behind nginx:
# 127.0.0.1:8088, so only nginx can reach it and it doesn't clash with anything else on 8080.
FRONTEND_PORT=
